---
import Base from "../components/home/Base.astro";
import Nav from "../components/home/Nav.astro";
import Hero from "../components/home/Hero.astro";
import Marquee from "../components/home/Marquee.astro";
import Bento from "../components/home/Bento.astro";
import Closing from "../components/home/Closing.astro";
import Footer from "../components/home/Footer.astro";
import ToTop from "../components/home/ToTop.astro";
import Features from "../islands/Features";
import Spaces from "../islands/Spaces";
import Topics from "../islands/Topics";
import Autopilot from "../islands/Autopilot";
---

<Base>
  <Nav />
  <main>
    <Hero />
    <Marquee />
    <section class="section">
      <Features client:only="solid-js" />
    </section>
    <section class="section">
      <Spaces client:visible />
    </section>
    <section class="section">
      <Topics client:visible />
    </section>
    <section class="section">
      <Autopilot client:only="solid-js" />
    </section>
    <Bento />
    <Closing />
  </main>
  <Footer />
  <ToTop />
</Base>

<script>
  import "../components/home/smoothScroll";
</script>
