---
import { SITE } from "../../config";
import { DOWNLOADS } from "../../downloads";

const here = (path: string): "page" | undefined => (Astro.url.pathname.startsWith(path) ? "page" : undefined);
const LINKS: { href: string; label: string; current?: "page" }[] = [
  { href: "/docs/", label: "Docs" },
  { href: "/packs/", label: "Packs", current: here("/packs") },
  { href: "/changelog/", label: "Changelog" },
  { href: SITE.github, label: "GitHub" },
];
---

<nav class="nav">
  <div class="bar">
  <a href="/" class="brand"><img src="/app-icon.png" alt="" width="22" height="22" />Tori</a>
  <span class="links">
    {LINKS.map((l) => <a href={l.href} aria-current={l.current}>{l.label}</a>)}
  </span>
  <button type="button" class="theme" data-theme-toggle aria-label="Switch between light and dark">
    <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg
    >
    <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      ><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
    >
  </button>
  <a href={DOWNLOADS.arm} class="download" data-dl data-intel={DOWNLOADS.intel}>Download</a>
  </div>
  <button type="button" class="menu" data-nav-menu aria-label="Open menu" aria-expanded="false" aria-controls="nav-sheet">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path class="bar-a" d="M4 8h16"></path>
      <path class="bar-b" d="M4 16h16"></path>
    </svg>
  </button>
  <div id="nav-sheet" class="sheet" data-nav-sheet hidden>
    {LINKS.map((l) => <a href={l.href} aria-current={l.current}>{l.label}</a>)}
    <button type="button" class="sheet-theme" data-theme-toggle>
      <span class="sun">Light mode</span>
      <span class="moon">Dark mode</span>
      <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg
      >
      <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
      >
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    display: flex;
    align-items: stretch;
    gap: 6px;
    white-space: nowrap;
  }
  .bar,
  .menu {
    background: var(--float);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    border: 1px solid var(--hair);
    box-shadow: 0 10px 40px var(--shadow);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 6px 6px 14px;
    border-radius: 999px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-right: 10px;
    color: var(--strong);
    font-weight: 700;
    font-size: 15px;
  }
  .links {
    display: flex;
  }
  .links a {
    padding: 7px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 13.5px;
    transition: color 0.2s, background 0.2s;
  }
  .links a:hover {
    color: var(--text);
    background: var(--glass);
  }
  .links a[aria-current] {
    color: var(--text);
    font-weight: 500;
  }
  .theme {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }
  .theme:hover {
    color: var(--text);
    background: var(--glass);
  }
  :global([data-theme="light"]) .sun,
  :global(:root:not([data-theme="light"])) .moon {
    display: none;
  }
  .download {
    display: flex;
    align-items: center;
    height: 34px;
    margin-left: 4px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    font-size: 13.5px;
  }
  .download:hover {
    color: var(--on-accent);
    background: var(--link-hover);
  }
  .menu {
    display: none;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 48px;
    padding: 0;
    border-radius: 999px;
    color: var(--text);
    cursor: pointer;
    transition: background 0.2s;
  }
  .menu:hover,
  .menu[aria-expanded="true"] {
    background: var(--glass-hi);
  }
  .menu path {
    transform-origin: 12px 12px;
    transition: transform 0.24s var(--ease);
  }
  .menu[aria-expanded="true"] .bar-a {
    transform: translateY(4px) rotate(45deg);
  }
  .menu[aria-expanded="true"] .bar-b {
    transform: translateY(-4px) rotate(-45deg);
  }
  .sheet {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 6px;
    border-radius: 18px;
    background: var(--raised);
    border: 1px solid var(--hair);
    box-shadow: 0 18px 50px var(--shadow);
    transform-origin: top center;
    animation: sheet-in 0.2s var(--ease) both;
  }
  .sheet[hidden] {
    display: none;
  }
  .sheet a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 12px;
    color: var(--soft);
    font-size: 15px;
  }
  .sheet a:hover,
  .sheet a:focus-visible {
    color: var(--text);
    background: var(--glass);
  }
  .sheet-theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    margin-top: 2px;
    padding: 0 14px;
    border: none;
    border-top: 1px solid var(--hair);
    border-radius: 0 0 12px 12px;
    background: transparent;
    color: var(--soft);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
  }
  .sheet-theme:hover {
    color: var(--text);
    background: var(--glass);
  }
  .sheet a[aria-current] {
    color: var(--text);
    font-weight: 500;
  }
  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }
  @media (max-width: 1099px) {
    .links {
      display: none;
    }
    .menu {
      display: flex;
    }
    .theme {
      display: none;
    }
  }
  @media (min-width: 1100px) {
    .sheet {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet {
      animation: none;
    }
    .menu path {
      transition: none;
    }
  }
</style>

<script>
  import { pointDownloads } from "./macArch";

  void pointDownloads();
  for (const toggle of document.querySelectorAll("[data-theme-toggle]")) {
    toggle.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
      localStorage.setItem("starlight-theme", next);
      document.documentElement.dataset.theme = next;
    });
  }

  const menu = document.querySelector<HTMLButtonElement>("[data-nav-menu]")!;
  const sheet = document.querySelector<HTMLElement>("[data-nav-sheet]")!;
  const setOpen = (open: boolean) => {
    sheet.hidden = !open;
    menu.setAttribute("aria-expanded", String(open));
    menu.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };
  menu.addEventListener("click", () => setOpen(!!sheet.hidden));
  sheet.addEventListener("click", (ev) => {
    if ((ev.target as Element).closest("a")) setOpen(false);
  });
  document.addEventListener("click", (ev) => {
    if (!sheet.hidden && !(ev.target as Element).closest(".nav")) setOpen(false);
  });
  document.addEventListener("keydown", (ev) => {
    if (ev.key !== "Escape" || sheet.hidden) return;
    setOpen(false);
    menu.focus();
  });
  matchMedia("(min-width: 1100px)").addEventListener("change", (ev) => ev.matches && setOpen(false));
</script>
