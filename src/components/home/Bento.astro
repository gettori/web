---
import AgentSvg from "./AgentSvg.astro";

const ORBIT = ["claude", "codex", "opencode", "copilot", "pi"];

// Real `tori` syntax and output (src-tauri/src/cli.rs): full session ids, the
// seven column table, `ask` printing only the answer, `spawn` printing the id.
const CLI: [string, string, number][] = [
  ["$ tori sessions --live", "var(--text)", 0],
  ["ID                                    AGENT   ACCOUNT  STATE      BRANCH          FOLDER                 TITLE", "var(--faint)", 0.5],
  ["7c1e9a2f-4b0d-4e2a-9f61-3d8c2b7a5e14  claude  work     needs you  feat/webhooks   ~/work/api-webhooks    Sign webhook payloads", "var(--need-hi)", 0.7],
  ["d4b80c13-9e7f-4a55-8c02-61f0e3a9b7d2  codex   default  working    fix/rate-limit  ~/work/api-rate-limit  Cap the rate limiter", "var(--work-hi)", 0.9],
  ["a92f6e07-3c1b-47d8-b5e6-0f4d9a2c8e31  gemini  default  idle       feat/search     ~/work/web-search      Search results page", "var(--done-hi)", 1.1],
  ['$ tori ask "Deploy to staging?"', "var(--text)", 2.4],
  ["yes", "var(--done-hi)", 4.2],
  ['$ tori spawn --agent codex --new-worktree fix/retry --prompt "retry 5xx deliveries"', "var(--text)", 5.4],
  ["0f3b7d5e-8c2a-4b1e-9d6f-2a7c4e1b9f30", "var(--work-hi)", 6.4],
  ['$ tori steer 0f3b7d5e-8c2a-4b1e-9d6f-2a7c4e1b9f30 "also cover 429s"', "var(--text)", 7.4],
  ["steer: 0f3b7d5e-8c2a-4b1e-9d6f-2a7c4e1b9f30", "var(--faint)", 8.2],
];
---

<section class="section bento">
  <div class="section-inner">
    <h2 class="h2 head">Everything around <span class="accent-word gold">the agent.</span></h2>
    <div class="grid">
      <div class="card orbit-card" data-spot style="--spot:217,164,104">
        <div class="text">
          <div class="title">Bring your own agent</div>
          <div class="body">
            Claude, Codex, OpenCode, Copilot and Pi come bundled. Anything that speaks ACP is a short TOML file, and any other CLI runs in a terminal tab with the same status dot.
          </div>
        </div>
        <div class="orbit">
          <div class="ring"></div>
          <div class="core"></div>
          <img src="/app-icon.png" alt="" class="sun" />
          <div class="spin">
            {
              ORBIT.map((a, i) => (
                <div class="arm" style={`transform:rotate(${Math.round((i * 360) / ORBIT.length)}deg) translateX(110px)`}>
                  <div style={`transform:rotate(-${Math.round((i * 360) / ORBIT.length)}deg)`}>
                    <div class={`planet p-${a}`}>
                      <AgentSvg agent={a} size={18} />
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="card steer-card" data-spot style="--spot:192,132,252">
        <div class="title">Steer mid-turn</div>
        <div class="body">Type while it works. The message lands at the agent's next step instead of waiting for the turn to end.</div>
        <div class="steer">
          <div class="steer-bubble"><span>Steer</span>also cover the retry path</div>
          <div class="steer-box">
            <div class="steer-status"><AgentSvg agent="claude" size={12} class="breathe" />Working 38s</div>
            <div class="steer-line">
              <span class="typed">also cover the retry path</span><span class="caret"></span>
            </div>
            <div class="steer-hint">Steer this turn, picked up in 1.5-5.4s</div>
          </div>
        </div>
      </div>

      <div class="card wake-card" data-spot style="--spot:217,164,104">
        <div class="title">Wakes when it matters</div>
        <div class="body">A chat can watch its pull request and wake when a check fails or a reviewer comments. One stopped by a usage limit carries on when the limit resets.</div>
        <svg viewBox="0 0 300 150" class="wake" fill="none" aria-hidden="true">
          <path d="M200 25 C140 25 150 75 96 75" class="rail"></path>
          <path d="M200 75 L96 75" class="rail"></path>
          <path d="M200 125 C140 125 150 75 96 75" class="rail"></path>
          <path d="M200 25 C140 25 150 75 96 75" class="flow"></path>
          <path d="M200 75 L96 75" class="flow"></path>
          <path d="M200 125 C140 125 150 75 96 75" class="flow"></path>
          <rect x="4" y="60" width="92" height="30" rx="15" class="gold-pill"></rect>
          <text x="50" y="80" text-anchor="middle" class="gold-t">your chat</text>
          <rect x="200" y="12" width="96" height="26" rx="8" class="node"></rect>
          <text x="248" y="29" text-anchor="middle" class="t">check failed</text>
          <rect x="200" y="62" width="96" height="26" rx="8" class="node"></rect>
          <text x="248" y="79" text-anchor="middle" class="t">new review</text>
          <rect x="200" y="112" width="96" height="26" rx="8" class="node"></rect>
          <text x="248" y="129" text-anchor="middle" class="t">limit reset</text>
        </svg>
      </div>

      <div class="card cli-card" data-spot style="--spot:217,164,104">
        <div class="cli-head">
          <div class="title">Scriptable</div>
          <div class="body">
            A <code>tori</code> CLI in every shell Tori opens, plus an MCP server, so scripts and agents can drive Tori too. <code
              >tori ask</code
            > puts a question in the chat that called it and waits for you.
          </div>
        </div>
        <div class="term">
          <div class="term-bar"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><span
              >zsh &middot; api/feat/webhooks</span
            ></div>
          <div class="term-body">
            {CLI.map(([t, c, d], i) => <div class:list={[i < 5 && "cli-table"]} style={`color:${c};animation-delay:${d}s`}>{t}</div>)}
          </div>
        </div>
      </div>

      <div class="card limits-card" data-spot style="--spot:251,113,133">
        <div class="title">See the limit coming</div>
        <div class="body">Every account you sign in gets its own quota bar. Cap a chat or a project in dollars, and a chat stopped by a limit picks up again when it resets.</div>
        <div class="usage" aria-hidden="true">
          <div class="u-row hot">
            <span class="u-who"><AgentSvg agent="claude" size={13} class="u-claude" />work</span>
            <span class="u-track"><i></i></span>
            <span class="u-pct u-swap"><b class="u-a">86%</b><b class="u-b">100%</b><b class="u-c">4%</b></span>
          </div>
          <div class="u-row">
            <span class="u-who"><AgentSvg agent="claude" size={13} class="u-claude" />personal</span>
            <span class="u-track"><i style="width:18%"></i></span>
            <span class="u-pct">18%</span>
          </div>
          <div class="u-row">
            <span class="u-who"><AgentSvg agent="codex" size={13} />codex</span>
            <span class="u-track"><i style="width:40%"></i></span>
            <span class="u-pct">40%</span>
          </div>
          <div class="u-head">Spending ceilings</div>
          <div class="u-row spend">
            <span class="u-who">This chat</span>
            <span class="u-track"><i class="u-gold" style="width:82%"></i></span>
            <span class="u-pct">$4.10 / $5</span>
          </div>
          <div class="u-row spend">
            <span class="u-who">This project</span>
            <span class="u-track"><i class="u-gold" style="width:61%"></i></span>
            <span class="u-pct">$12.30 / $20</span>
          </div>
          <div class="u-slot">
            <div class="u-event u-stop"><i></i>Limit reached on work. Resumes at 14:00.</div>
            <div class="u-event u-go"><i></i>Limit reset. The chat carried on.</div>
          </div>
        </div>
      </div>

      <div class="card trust-card" data-spot style="--spot:45,212,191">
        <div class="title">Nothing runs until you trust it</div>
        <div class="body">Clone a repo and its own code waits: hooks, language servers, formatters, debuggers. The answer lives in your config, so a repo cannot trust itself.</div>
        <div class="trust" aria-hidden="true">
          <div class="t-ask">
            <b>Trust hooli-search?</b>
            <span class="t-btns"><span>Not now</span><span class="t-yes">Trust<i class="tap"></i></span></span>
          </div>
          {
            ["Git and its hooks", "Language servers", "Formatter on save", "Debugger", "Agent folder settings"].map((x, i) => (
              <div class="t-row" style={`--d:${i * 0.12}s`}>
                <span class="t-lock">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
                </span>
                <span class="t-ok">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12 9 17 20 6"></path></svg>
                </span>
                {x}
                <em><span class="t-held">held</span><span class="t-ready">ready</span></em>
              </div>
            ))
          }
        </div>
      </div>

      <div class="card privacy-card" data-spot style="--spot:45,212,191">
        <div class="title">Private by construction</div>
        <div class="body">No telemetry. Your agent talks to its vendor on your subscription, exactly as in a terminal. Tori proxies nothing.</div>
        <svg viewBox="0 0 300 120" class="privacy" fill="none" aria-hidden="true">
          <path d="M66 40 L236 40" stroke-width="2" stroke-dasharray="6 10" class="flow-teal"></path>
          <path d="M66 90 L176 90" class="dim" stroke-width="2" stroke-dasharray="3 7"></path>
          <circle cx="196" cy="90" r="13" class="off" stroke-width="2"></circle>
          <path d="M187 99 L205 81" class="off" stroke-width="2"></path>
          <rect x="2" y="26" width="64" height="28" rx="8" class="node"></rect>
          <text x="34" y="44" text-anchor="middle" class="t">agent</text>
          <rect x="236" y="26" width="62" height="28" rx="8" class="teal-pill"></rect>
          <text x="267" y="44" text-anchor="middle" class="teal-t">vendor</text>
          <rect x="2" y="76" width="64" height="28" rx="8" class="gold-pill"></rect>
          <text x="34" y="94" text-anchor="middle" class="gold-t">tori</text>
          <text x="222" y="95" class="faint-t">nothing</text>
        </svg>
      </div>

      <div class="card restore-card" data-spot style="--spot:192,132,252">
        <div class="text">
          <div class="title">Picks up where you left off</div>
          <div class="body">
            Quit with forty tabs open and they all come back, in order. Nothing starts until you click one: a session resumes its conversation, a shell gets a fresh prompt, and unsaved edits are still there.
          </div>
        </div>
        <div class="rtabs" aria-hidden="true">
          <span class="rtab"><i></i>Sign webhook payloads</span>
          <span class="rtab live"><i></i>Cap the rate limiter</span>
          <span class="rtab"><i></i>zsh</span>
          <span class="rtab"><i></i>deliver.ts</span>
          <span class="rtab"><i></i>Search results page</span>
          <span class="rtab"><i></i>sign.test.ts</span>
          <span class="rtab"><i></i>Bump provider versions</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .head {
    max-width: 14ch;
  }
  .gold {
    color: var(--link);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "orbit" "steer" "wake" "cli" "limits" "trust" "privacy" "restore";
    gap: 12px;
    margin-top: 40px;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas: "orbit orbit" "steer wake" "cli cli" "limits trust" "privacy restore";
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-areas: "orbit steer wake limits" "cli trust privacy restore";
    }
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 260px;
    padding: 26px;
    border-radius: 26px;
    overflow: hidden;
    background:
      radial-gradient(420px circle at var(--x, 50%) var(--y, 50%), rgba(var(--spot), 0.11), transparent 50%),
      var(--card);
    border: 1px solid var(--hair);
  }
  .title {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .body {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }
  .body code {
    font-family: var(--mono);
    color: var(--link);
  }

  .orbit-card {
    grid-area: orbit;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    min-height: 280px;
  }
  .text {
    flex: 1 1 220px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .orbit {
    position: relative;
    flex: 1 1 240px;
    height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ring {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 1px dashed var(--line);
  }
  .core {
    position: absolute;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(217, 164, 104, 0.25), transparent 70%);
  }
  .sun {
    position: relative;
    z-index: 2;
    width: 60px;
    height: 60px;
    filter: drop-shadow(0 0 30px rgba(217, 164, 104, 0.5));
  }
  .spin {
    position: absolute;
    width: 220px;
    height: 220px;
    animation: v-spin 26s linear infinite;
  }
  .arm {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
  }
  .planet {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    border-radius: 12px;
    background: var(--raised);
    border: 1px solid var(--line);
    box-shadow: 0 8px 20px var(--shadow);
    color: var(--text);
    animation: spinr 26s linear infinite;
  }
  @keyframes spinr {
    to {
      transform: rotate(-360deg);
    }
  }
  .p-claude {
    color: #d97757;
  }
  .p-gemini {
    color: #8e75b2;
  }

  .steer-card {
    grid-area: steer;
    min-height: 280px;
  }
  .steer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .steer-bubble {
    align-self: flex-end;
    padding: 7px 12px;
    border-radius: 10px;
    border: 1px solid var(--hair);
    background: light-dark(#ecebe7, #272628);
    font-size: 13px;
    animation: steerIn 7s infinite;
  }
  .steer-bubble span {
    display: block;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--work-hi);
  }
  @keyframes steerIn {
    0%,
    62% {
      opacity: 0;
      transform: translateY(8px);
    }
    68%,
    94% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }
  .steer-box {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    border-radius: 16px;
    background: light-dark(#f6f5f2, #0b0c10);
    border: 1px solid var(--hair);
  }
  .steer-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--work-hi);
  }
  .steer-status :global(.breathe) {
    color: #d97757;
    animation: v-breathe 1.6s infinite;
  }
  .steer-line {
    display: flex;
    align-items: center;
    min-height: 20px;
    font-family: var(--mono);
    font-size: 13px;
  }
  .typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    animation: type 7s steps(25) infinite;
  }
  @keyframes type {
    0% {
      width: 0;
    }
    50%,
    60% {
      width: 25ch;
    }
    62%,
    100% {
      width: 0;
    }
  }
  .caret {
    width: 7px;
    height: 15px;
    background: #d9a468;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .steer-hint {
    font-size: 12px;
    color: var(--faint);
  }

  .tap {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border-radius: 50%;
    background: #fff;
  }

  .wake-card {
    grid-area: wake;
  }
  .wake,
  .privacy {
    margin-top: auto;
    width: 100%;
    height: auto;
    font-family: var(--mono);
    font-size: 12px;
  }
  .rail {
    stroke: var(--line);
    stroke-width: 2;
  }
  .flow {
    stroke: var(--link);
    stroke-width: 2;
    stroke-dasharray: 6 14;
    animation: flow 1.2s linear infinite;
  }
  .flow-teal {
    stroke: var(--done);
    animation: flow 1s linear infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -40;
    }
  }
  .node {
    fill: var(--raised);
    stroke: var(--line);
  }
  .t {
    fill: var(--text);
  }
  .faint-t {
    fill: var(--faint);
  }
  .dim {
    stroke: var(--line);
  }
  .off {
    stroke: light-dark(rgba(20, 22, 30, 0.3), rgba(255, 255, 255, 0.3));
  }
  .gold-pill {
    fill: light-dark(#fbf0e0, #2a2116);
    stroke: #d9a468;
  }
  .gold-t {
    fill: light-dark(#8a5a1c, #f3d3a4);
  }
  .teal-pill {
    fill: light-dark(#e3f5f2, #12211f);
    stroke: rgba(45, 212, 191, 0.5);
  }
  .teal-t {
    fill: light-dark(#0f766e, #99f6e4);
  }

  .cli-card {
    grid-area: cli;
  }
  .cli-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
  }
  .cli-head .body {
    flex: 1 1 320px;
  }
  .term {
    color: var(--text);
    flex: 1;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    background: light-dark(#ffffff, var(--term));
    border: 1px solid var(--hair);
    overflow: hidden;
  }
  .term-bar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    background: light-dark(#ececef, #121419);
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--faint);
  }
  .term-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .term-bar span {
    margin-left: 8px;
  }
  .term-body {
    position: relative;
    padding: 16px 18px;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.8;
    overflow: hidden;
    mask-image: linear-gradient(90deg, #000 88%, transparent);
  }
  .term-body div {
    white-space: pre;
    opacity: 0;
    animation: cli 11s infinite;
  }
  @keyframes cli {
    0%,
    4% {
      opacity: 0;
      transform: translateY(4px);
    }
    8%,
    88% {
      opacity: 1;
      transform: none;
    }
    96%,
    100% {
      opacity: 0;
    }
  }

  .limits-card {
    grid-area: limits;
  }
  .usage {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 16px;
    border-radius: 16px;
    border: 1px solid var(--hair);
    background: light-dark(#f6f5f2, #0b0c10);
    font-size: 12.5px;
  }
  .u-row {
    display: grid;
    grid-template-columns: 86px 1fr auto;
    align-items: center;
    gap: 10px;
  }
  .u-who {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--soft);
    white-space: nowrap;
  }
  .u-who :global(.u-claude) {
    color: #d97757;
  }
  .u-track {
    height: 6px;
    border-radius: 3px;
    background: var(--glass-hi);
    overflow: hidden;
  }
  .u-track i {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: var(--work);
  }
  .u-track .u-gold {
    background: #d9a468;
  }
  .u-pct {
    min-width: 48px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    text-align: right;
  }
  .u-pct b {
    font-weight: 500;
  }
  .hot .u-track i {
    animation: uBar 9s var(--ease) infinite;
  }
  .u-swap {
    position: relative;
    height: 15px;
  }
  .u-swap b {
    position: absolute;
    right: 0;
    opacity: 0;
  }
  .hot .u-a {
    animation: uA 9s infinite;
  }
  .hot .u-b {
    color: var(--need-hi);
    animation: uB 9s infinite;
  }
  .hot .u-c {
    animation: uC 9s infinite;
  }
  @keyframes uBar {
    0% {
      width: 72%;
      background: var(--work);
    }
    30% {
      background: var(--work);
    }
    38% {
      background: var(--need);
    }
    42%,
    70% {
      width: 100%;
      background: var(--need);
    }
    74%,
    100% {
      width: 4%;
      background: var(--work);
    }
  }
  @keyframes uA {
    0%,
    38% {
      opacity: 1;
